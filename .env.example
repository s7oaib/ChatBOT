# Public URL where this bot is reachable (ngrok URL for testing, your domain in production).
# Meta uses this public URL to fetch Instagram menu photo cards.
# Example: https://xxxx.ngrok-free.app  or  https://bot.camelliaartisanal.com
PUBLIC_BASE_URL=

# Private value configured here and identically in Meta webhook settings.
# Generate a unique random value for each deployment; never use a repository default.
META_VERIFY_TOKEN=replace_with_private_meta_verify_token
# REQUIRED IN PRODUCTION. Meta App Dashboard > Settings > Basic > App Secret.
# Every Instagram webhook POST must carry a valid signature made with this key.
META_APP_SECRET=your_meta_app_secret_here

# Required in production. The default is true; missing secrets make signed POSTs
# fail closed. A local test that intentionally sends unsigned synthetic traffic
# must explicitly set REQUIRE_WEBHOOK_SIGNATURE=false in its isolated context.
REQUIRE_WEBHOOK_SIGNATURE=true

# High-entropy machine authentication for trusted tools only. Never put this
# value in browser JavaScript or use it as the browser password.
ADMIN_API_KEY=
# Browser admin identity. Generate the password hash with:
#   python scripts/generate_admin_password_hash.py
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
ADMIN_REQUIRE_HTTPS=true
ADMIN_MAINTENANCE_MODE=false
ADMIN_SESSION_IDLE_SECONDS=1800
ADMIN_SESSION_ABSOLUTE_SECONDS=28800

# Manual WhatsApp continuation. This is only used to build the customer-facing
# wa.me link; this service has no WhatsApp webhook, bot, or Cloud API sender.
WHATSAPP_BUSINESS_NUMBER=

# Instagram Ad-Gate. When false, the bot answers ONLY Instagram DMs that came
# from a paid ad (referral.source == "ADS"); organic DMs are left untouched in
# the inbox for a human to answer. Set true to auto-reply to every DM.
# Production currently runs true — see DEPLOYMENT.md for the reasoning.
BYPASS_AD_GATE=true

# Meta Instagram Business Page ID
# Optional account-level webhook guard. When set, only matching entry.id values
# are processed; foreign Instagram account entries still receive HTTP 200.
INSTAGRAM_ACCOUNT_ID=
# Instagram Login Graph /me ID used only for authenticated owned-media sync.
# Keep separate from INSTAGRAM_ACCOUNT_ID, which guards webhook entry.id.
INSTAGRAM_GRAPH_ACCOUNT_ID=
# Instagram Business Login app credentials. These must belong to the same
# Instagram App ID that issues the authorization code; do not copy the old
# Page/webhook app secret here unless Meta confirms the pairing.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=https://web-production-0cad70.up.railway.app/auth/instagram/callback
INSTAGRAM_EXPECTED_USERNAME=camellia.artisanal
# Select the Graph credential family explicitly. Legacy Page-token behavior is
# available only as INSTAGRAM_AUTH_MODE=legacy_page; never infer this from a
# token prefix.
INSTAGRAM_AUTH_MODE=instagram_login
INSTAGRAM_PAGE_ID=your_instagram_page_id
# Instagram Login access token. In legacy_page mode, use the Page access token.
INSTAGRAM_ACCESS_TOKEN=

# Slow-reply notice.
# When a reply takes longer than SLOW_REPLY_THRESHOLD_MS, the customer is told
# once per conversation that replies are delayed and given the manager's direct
# line — they can either switch to him or carry on with the bot. Fast replies
# never trigger it.
SLOW_REPLY_NOTICE_ENABLED=true
SLOW_REPLY_THRESHOLD_MS=3000
# The notice promises a limited period, so set an end date (YYYY-MM-DD) and it
# stops sending itself afterwards. Leave empty for no expiry.
SLOW_REPLY_NOTICE_UNTIL=
# Optional: override the wording (defaults to the client's approved copy).
SLOW_REPLY_NOTICE_TEXT=

# Data Storage Paths
DB_PATH=camellia.db
MENU_JSON_PATH=data/menu.json
QA_TEMPLATES_PATH=data/qa_templates.json

# Browser chat tester at /chat. It writes real conversation rows and fires real
# escalation alerts, so keep it false on any public domain.
ENABLE_WEB_TESTER=false

# Conversations, escalations and sessions older than this are deleted on startup.
# This number is what the /privacy page promises customers.
DATA_RETENTION_DAYS=90

# Shown on the /privacy and /terms pages that Meta requires.
BUSINESS_LEGAL_NAME=Camellia Artisanal
PRIVACY_CONTACT_EMAIL=owner@camelliaartisanal.com

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Optional: Published Google Sheet CSV URL for Self-Service Menu Updates (Option A in PRD)
GOOGLE_SHEET_CSV_URL=https://docs.google.com/spreadsheets/d/e/.../pub?output=csv

# Groq API Key (RAG fallback + QA template refinement for the chat responder)
# Note: OFF by default ($0 cost, uses deterministic regex parser) until a key is set.
# If enabled, MUST use the client's own key under their own Groq account (https://console.groq.com/keys).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Optional polish only. Keep below SLOW_REPLY_THRESHOLD_MS so an overloaded
# provider is skipped instead of making the customer wait.
GROQ_REFINE_TIMEOUT=2.5
GROQ_TIMEOUT=20.0
GROQ_ENABLED=true

# Phase 3/4 AI review controls. Simulation evaluates deterministic Auto Resolve
# gates and records evidence; it never sends a customer reply.
LLM_TRIAGE_ENABLED=true
LLM_ASSISTED_RESOLUTION_ENABLED=true
LLM_AUTO_RESOLVE_SIMULATION_ENABLED=true
LLM_AUTO_RESOLVE_ENABLED=false
LLM_AUTO_RESOLVE_MIN_CONFIDENCE=0.95
# Leave empty to observe all explicitly safe categories in simulation.
LLM_AUTO_RESOLVE_ALLOWED_CATEGORIES=

# Live semantic intent fallback. It is used only when keyword/fuzzy matching
# has no confident result, and can select only approved non-guard templates.
SEMANTIC_ROUTER_ENABLED=true
CONVERSATION_IMPROVEMENTS_ENABLED=true
# Primary structured NLU/router model. Keep separate from GROQ_MODEL so
# high-frequency classification does not consume the reply model's bucket.
GROQ_ROUTER_MODEL=openai/gpt-oss-120b
LLM_TRIAGE_MODEL=openai/gpt-oss-20b
# Stable customer cohort for staged structured-NLU rollout (0-100).
STRUCTURED_NLU_ENABLED=true
STRUCTURED_NLU_ROLLOUT_PERCENT=100
# Second understanding model, tried once when the first one runs out of
# capacity (quota, rate limit, provider error). Empty explicitly disables the
# fallback and fails closed to the deterministic path.
STRUCTURED_NLU_FALLBACK_MODEL=openai/gpt-oss-20b

# Store active conversation facts/turns in DB_PATH so restarts retain context.
SESSION_PERSISTENCE_ENABLED=true
SESSION_TTL_SECONDS=86400

# Menu flyer photo OCR. GROQ_MODEL above has no vision, but Groq serves
# multimodal models on the same key, so GROQ_API_KEY alone is enough.
# Model list: https://console.groq.com/docs/vision
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# Read-only Ads inventory; uses INSTAGRAM_API_VERSION. Server only.
META_MARKETING_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
