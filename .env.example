# Public URL where this bot is reachable (ngrok URL for testing, your domain in production).
# WhatsApp needs this to fetch menu photo cards — without it images are skipped.
# Example: https://xxxx.ngrok-free.app  or  https://bot.camelliaartisanal.com
PUBLIC_BASE_URL=

# Meta & Webhook Verification Token (Choose a secret string for Meta App dashboard)
# Generate a private random value for production.
META_VERIFY_TOKEN=replace_with_private_webhook_token
META_APP_SECRET=your_meta_app_secret_here

# Protects /admin/* endpoints (customer logs & menu overwrite).
# Leave blank to disable the guard; ALWAYS set a long random value in production.
ADMIN_API_KEY=
# Dedicated 4-6 digit Admin PIN for the /admin kitchen portal
ADMIN_PIN=

# Meta WhatsApp Business Cloud API Settings
# Keep mock mode enabled until a separate WhatsApp API number has been created and tested.
WHATSAPP_MOCK_MODE=true
# Add credentials later; never commit the real values.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v19.0

# Meta Instagram Business Page ID
INSTAGRAM_PAGE_ID=your_instagram_page_id
# Instagram Page access token. If blank, falls back to WHATSAPP_ACCESS_TOKEN.
# In production these are two different tokens — get the Instagram one from
# Meta → App → Instagram → API Setup → Generate token.
INSTAGRAM_ACCESS_TOKEN=

# Human Escalation Contact (Number or Email to notify when a query needs human attention)
HUMAN_ESCALATION_PHONE=+918796551990
HUMAN_ESCALATION_EMAIL=owner@camelliaartisanal.com

# Slow-reply notice.
# When a reply takes longer than SLOW_REPLY_THRESHOLD_MS, the customer is told
# once per conversation that replies are delayed and given the manager's direct
# line — they can either switch to him or carry on with the bot. Fast replies
# never trigger it.
SLOW_REPLY_NOTICE_ENABLED=true
SLOW_REPLY_THRESHOLD_MS=3000
# The notice promises a limited period, so set an end date (YYYY-MM-DD) and it
# stops sending itself afterwards. Leave empty for no expiry.
SLOW_REPLY_NOTICE_UNTIL=
# Optional: override the wording (defaults to the client's approved copy).
SLOW_REPLY_NOTICE_TEXT=

# Data Storage Paths
DB_PATH=camellia.db
MENU_JSON_PATH=data/menu.json
QA_TEMPLATES_PATH=data/qa_templates.json

# Browser chat tester at /chat. It writes real conversation rows and fires real
# escalation alerts, so keep it false on any public domain.
ENABLE_WEB_TESTER=false

# Conversations, escalations and sessions older than this are deleted on startup.
# This number is what the /privacy page promises customers.
DATA_RETENTION_DAYS=90

# Shown on the /privacy and /terms pages that Meta requires.
BUSINESS_LEGAL_NAME=Camellia Artisanal
PRIVACY_CONTACT_EMAIL=owner@camelliaartisanal.com

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Optional: Published Google Sheet CSV URL for Self-Service Menu Updates (Option A in PRD)
GOOGLE_SHEET_CSV_URL=https://docs.google.com/spreadsheets/d/e/.../pub?output=csv

# Google Gemini Cloud AI API Key (Optional: for flyer Vision OCR & RAG fallback)
# Note: OFF by default ($0 cost, uses deterministic regex parser / Google Sheets sync).
# If enabled, MUST use the client's own key under their own Google Cloud account (https://aistudio.google.com/app/apikey).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Optional polish only. Keep below SLOW_REPLY_THRESHOLD_MS so an overloaded
# provider is skipped instead of making the customer wait.
GEMINI_REFINE_TIMEOUT=2.5
GEMINI_TIMEOUT=20.0
GEMINI_ENABLED=true

