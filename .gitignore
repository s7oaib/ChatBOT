scratch/
simulation_results.json

# Uploaded weekly flyer photos. Written next to menu.json (see
# camellia/weekly_flyer.py) so they land on the mounted volume in production;
# locally that resolves under data/, and a photo an operator tests with here
# does not belong in the repo.
data/uploads/



# Local-only working files. Kept on disk, deliberately not tracked:
# a personal working log, and the dev-server config read by local tooling.
PROJECT_JOURNAL.md
.claude/

# Claude Code plugin/tooling state, not part of the bot. .claude-flow/ is a
# hook-call audit log the ruflo-core plugin writes automatically on every MCP
# tool call; .specify/ is spec-kit's scaffolding. Neither belongs in history.
.claude-flow/
.specify/
